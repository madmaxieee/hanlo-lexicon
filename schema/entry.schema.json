{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alternate_readings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "canonical_tl": {
      "minLength": 1,
      "type": "string"
    },
    "editorial_rationale": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minimum": 1,
      "type": "integer"
    },
    "identity_note": {
      "description": "Distinguishes unrelated homographs; not a full definition.",
      "minLength": 1,
      "type": "string"
    },
    "moe_forms": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "preferred_form": {
      "minLength": 1,
      "type": "string"
    },
    "review_status": {
      "enum": [
        "imported",
        "reviewed",
        "disputed"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "snapshot",
              "row"
            ],
            "type": "object"
          },
          {
            "required": [
              "url",
              "locator"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "locator": {
            "minLength": 1,
            "type": "string"
          },
          "row": {
            "minimum": 1,
            "type": "integer"
          },
          "sheet": {
            "minLength": 1,
            "type": "string"
          },
          "snapshot": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "usage_notes": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "canonical_tl",
    "preferred_form",
    "alternate_readings",
    "moe_forms",
    "review_status",
    "sources"
  ],
  "title": "Han-Lo vocabulary entry",
  "type": "object"
}
