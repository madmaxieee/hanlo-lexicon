{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Han-Lo vocabulary entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "canonical_tl",
    "preferred_form",
    "alternate_readings",
    "moe_forms",
    "other_spellings",
    "mandarin_meanings",
    "examples",
    "review_status",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^e[0-9]{6}$"
    },
    "canonical_tl": {
      "type": "string",
      "minLength": 1
    },
    "preferred_form": {
      "type": "string",
      "minLength": 1
    },
    "alternate_readings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "moe_forms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "other_spellings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mandarin_meanings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review_status": {
      "enum": [
        "imported",
        "reviewed",
        "disputed"
      ]
    },
    "usage_notes": {
      "type": "string",
      "minLength": 1
    },
    "editorial_rationale": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot",
          "row",
          "fields"
        ],
        "properties": {
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "row": {
            "type": "integer",
            "minimum": 1
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
